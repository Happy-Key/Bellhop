# ---------------------------------------------------------------------------
# PLACEHOLDERS ONLY. Copy what you need into .env.local (never committed).
# Variables marked [CONVEX] must ALSO be set in the Convex deployment:
#   npx convex env set NAME value
# Convex functions read ONLY the Convex deployment environment, not .env.local.
# ---------------------------------------------------------------------------

# --- Written automatically by `npx convex dev` into .env.local --------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Capital One Nessie (https://nessieisreal.com) ---------------------------
# [CONVEX] + .env.local (scripts). Key from GitHub login at nessieisreal.com.
NESSIE_API_KEY=
# [CONVEX] + .env.local. Printed by `npm run seed:nessie -- --confirm`.
NESSIE_DEMO_ACCOUNT_ID=
# [CONVEX] only. Demo personas on /call: JSON {"margaret":"<account id>",...}, printed by
# `npm run seed:personas -- --confirm`. Not secret, but never accepted from the client.
NESSIE_PERSONA_ACCOUNTS=
# Optional override. Default https://api.nessieisreal.com
NESSIE_BASE_URL=

# --- Runtime reasoning (provider-independent) --------------------------------
# [CONVEX]. "scripted" (default, deterministic, labelled) or "openai-compatible".
REASONING_PROVIDER=scripted
# [CONVEX] + [.env.local for `npm run live:reasoning`]. Only when REASONING_PROVIDER=openai-compatible.
# Provider: Bitdeer (https://developers.bitdeer.ai/docs/api). Key: https://www.bitdeer.ai/en/model/apikeys
REASONING_PROVIDER_LABEL=bitdeer
REASONING_BASE_URL=https://api-inference.bitdeer.ai/v1
REASONING_API_KEY=
# A model ID from `npm run live:reasoning -- --models`, e.g. deepseek-ai/DeepSeek-V4.1-Flash
REASONING_MODEL=

# --- Cartesia (voice) ---------------------------------------------------------
# [CONVEX]. Permanent key — never in the browser. https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# [CONVEX]. Managed Agent id from the Cartesia playground.
CARTESIA_AGENT_ID=
# [CONVEX]. Random secret you generate; configure the same value as the bearer
# token on the Cartesia webhook tool that calls /voice/tools/record-statement.
VOICE_TOOL_SECRET=

# --- CRS Credit API sandbox (identity check) -----------------------------------
# [CONVEX]. Sandbox credentials arrive by email. QUOTE the password in .env.local.
CRS_BASE_URL=https://api-sandbox.stitchcredit.com:443/api
CRS_USERNAME=
CRS_PASSWORD=

# --- Factory Droid SDK (NOT YET IMPLEMENTED; developer-side only) -------------
# .env.local / shell only. Never in Convex or the browser.
FACTORY_API_KEY=
